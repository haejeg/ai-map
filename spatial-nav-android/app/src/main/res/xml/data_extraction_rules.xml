<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keep encrypted API keys out of cloud backups and device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="api_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="api_keys.xml" />
    </device-transfer>
</data-extraction-rules>
